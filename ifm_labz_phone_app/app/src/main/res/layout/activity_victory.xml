<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/game_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvVictoryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SYSTEM STATUS: ACCESS GRANTED"
        android:textColor="#FF7A00"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvVictorySubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Decryption Successful"
        android:textColor="#88888F"
        android:textSize="14sp"
        android:textStyle="italic"
        android:fontFamily="monospace"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvVictoryTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvVictoryContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="&lt;font color='#FF7A00'&gt;&lt;b&gt;ACCESS GRANTED:&lt;/b&gt;&lt;/font&gt; The dual-frequency barrier has been successfully bypassed.&lt;br/&gt;
    &lt;font color='#FF7A00'&gt;&lt;b&gt;SYNC CONFIRMED:&lt;/b&gt;&lt;/font&gt; Your synchronized signal injection matched the server's target, locking the mainframe into a stable state.&lt;br/&gt;
    &lt;font color='#FF7A00'&gt;&lt;b&gt;NETWORK STATUS:&lt;/b&gt;&lt;/font&gt; The network infrastructure is now secure and the data collapse has been contained.&lt;br/&gt;
    &lt;font color='#FF7A00'&gt;&lt;b&gt;MISSION COMPLETE:&lt;/b&gt;&lt;/font&gt; You have successfully completed the mission. Pack up the hardware and log out. The grid belongs to us."
        android:textColor="#E2E2E6"
        android:textSize="16sp"
        android:lineSpacingMultiplier="1.2"
        android:fontFamily="monospace"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvVictorySubtitle"
        app:layout_constraintBottom_toTopOf="@id/btnVictoryBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnVictoryBack"
        android:layout_width="180dp"
        android:layout_height="54dp"
        android:text="RETURN TO MENU"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF7A00"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>