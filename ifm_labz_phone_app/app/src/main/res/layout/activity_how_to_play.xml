<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/game_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvHowToTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.1"
        android:text="MISSION RULES"
        android:textColor="#FF7A00"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvHowToSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="How the console and the game works"
        android:textColor="#88888F"
        android:textSize="13sp"
        android:textStyle="italic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHowToTitle" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="180dp"
        android:layout_height="54dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="#FF7A00"
        android:text="BACK TO MENU"
        android:textColor="#E2E2E6"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.533" />


    <ScrollView
        android:id="@+id/rulesScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnBack"
        app:layout_constraintTop_toBottomOf="@id/tvHowToSubtitle"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvRulesContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            android:text="&lt;font color='#FF7A00'&gt;&lt;b&gt;1. CONNECTION:&lt;/b&gt;&lt;/font&gt; Ensure your console is powered on and connected to the same Wi-Fi network as this phone.&lt;br/&gt;&lt;br/&gt;&lt;font color='#FF7A00'&gt;&lt;b&gt;2. SERVER STATUS:&lt;/b&gt;&lt;/font&gt; Your phone acts as the central host, synchronizing gameplay data in real-time.&lt;br/&gt;&lt;br/&gt;&lt;font color='#FF7A00'&gt;&lt;b&gt;3. THE MISSION:&lt;/b&gt;&lt;/font&gt; You and your teammate have to bypass a security bypass based on 3 digits before the countdown hits zero !&lt;br/&gt;&lt;br/&gt;&lt;font color='#FF7A00'&gt;&lt;b&gt;4. BOOSTERS:&lt;/b&gt;&lt;/font&gt; Use the boosters carefully, the mainframe is fighting back so make sure you choose the right time to make a move!"
            android:textAllCaps="true"
            android:textColor="#E2E2E6"
            android:textSize="15sp" />

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>