<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/game_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvStoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:text="SYSTEM WARNING: NEXUS COMPROMISED"
        android:textColor="#FF0000"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.081"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.069" />

    <TextView
        android:id="@+id/tvStorySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="21dp"
        android:layout_marginTop="4dp"
        android:text="Decryption Storyline Terminal"
        android:textColor="#88888F"
        android:textSize="13sp"
        android:textStyle="italic"
        android:fontFamily="monospace"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.044"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStoryTitle"
        app:layout_constraintVertical_bias="0.031" />

    <TextView
        android:id="@+id/tvStoryContent"
        android:layout_width="582dp"
        android:layout_height="238dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:lineSpacingMultiplier="1.2"
        android:fontFamily="monospace"
        android:textColor="#E2E2E6"
        android:textSize="15sp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:text="&lt;font color=\'#FF7A00\'&gt;&lt;b&gt;YEAR: 1989:&lt;/b&gt;&lt;/font&gt; The NEXUS Mainframe has been compromised by a critical system anomaly. Communication grids are collapsing in real-time. The server's core is locked behind an unstable, shifting dual-frequency barrier.&lt;br/&gt;&lt;br/&gt;&lt;font color=\'#FF7A00\'&gt;&lt;b&gt;YOUR MISSION:&lt;/b&gt;&lt;/font&gt; As System Engineers, you must manually bypass the security protocols. To unlock the core, your physical Encryption Console must inject a combined signal that matches the server's fluctuating target frequency.&lt;br/&gt;&lt;br/&gt; &lt;font color=\'#FF7A00\'&gt;&lt;b&gt;BE AWARE:&lt;/b&gt;&lt;/font&gt; The mainframe is fighting back by actively jamming your signals and draining your system's integrity. Work together, synchronize your transmitters, and save the system before the countdown hits zero. Failure is not an option."
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnBeginBypass"
        app:layout_constraintHorizontal_bias="0.591"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStorySubtitle"
        app:layout_constraintVertical_bias="0.722" />

    <Button
        android:id="@+id/btnBeginBypass"
        android:layout_width="180dp"
        android:layout_height="54dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="#FF7A00"
        android:text="BEGIN BYPASS"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:fontFamily="monospace"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.533" />

</androidx.constraintlayout.widget.ConstraintLayout>